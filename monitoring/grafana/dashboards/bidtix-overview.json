      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"bidtix-backend\"}[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
